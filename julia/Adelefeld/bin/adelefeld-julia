#!/bin/sh
# julia/Adelefeld/bin/adelefeld-julia: start Julia with the system libgmp preloaded, then exec it with
# the arguments given (docs/api-j.md:85-87, the launcher of step J-a).
#
# Why: this Julia (juliaup) loads its bundled libgmp.so.10 at startup, which lacks the plain symbol
# __gmpn_modexact_1_odd that the system libflint.so.18 needs; dlopen of libadelefeld.so then fails, and
# LD_PRELOAD set from inside Julia is too late (tests/julia/README.md:39-69; docs/api-j.md:80-84).
# The system libgmp.so.10 is found the way tests/test_julia.sh finds it: the first libgmp.so.10 that
# `ldconfig -p` lists. It is put first in LD_PRELOAD unless LD_PRELOAD already names it. If none is found,
# Julia starts unchanged and the package's load gate reports the exact preload command.
#
# Environment: JULIA (default julia). Example, from the repository root:
#     julia/Adelefeld/bin/adelefeld-julia --project=julia/Adelefeld -e 'using Adelefeld; println(Rat(1)/3)'

JULIA=${JULIA:-julia}
gmp=$(ldconfig -p 2> /dev/null | awk '/libgmp\.so\.10 /{print $NF; exit}')
if [ -n "$gmp" ] && [ -f "$gmp" ]; then
    case ":${LD_PRELOAD:-}:" in
        *":$gmp:"*) ;;
        *) LD_PRELOAD="$gmp${LD_PRELOAD:+:$LD_PRELOAD}" ;;
    esac
    export LD_PRELOAD
fi
exec "$JULIA" "$@"
