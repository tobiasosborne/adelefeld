diff --git a/lanes/r-cost1/exact_high.c b/lanes/r-cost1/exact_high.c
new file mode 100644
index 0000000000000000000000000000000000000000..c44cb3b8de303be29e46924ad10f83617dad2d24
--- /dev/null
+++ b/lanes/r-cost1/exact_high.c
@@ -0,0 +1,108 @@
+/* Independent exact signs: power for X^50 - 2, balanced factor product for Wilkinson + 1.
+   fmpz_pow_ui: refs/src/flint-3.0.1/fmpz.rst:913-917.
+   The identities are algebraic: clear the positive dyadic denominator from each expression.
+   Count two: evenness and strict monotonicity of x^50 on x > 0, with signs at 1 and 2.
+   Count fifty: exact opposite signs at i +/- 1/4, fifty disjoint intervals, degree fifty.
+   The existence inference uses the same pending IVT source as solvers P3.8. */
+#define _POSIX_C_SOURCE 200809L
+#include <adelefeld.h>
+#include <flint/fmpz_vec.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+int adf_roots_real_isolate_counted(arb_ptr b, slong * m, const fmpz_poly_t g, slong prec, slong count);
+
+static int sign_value(const fmpz_t m, slong e, int wilkinson)
+{
+    fmpz_t den, power, value;
+    fmpz * factors;
+    slong i, n, j;
+    int sign;
+    if (e >= 0 || e == WORD_MIN || (ulong) (-e) > ((ulong) WORD_MAX - 1) / 50)
+        flint_abort();
+    fmpz_init_set_ui(den, 1); fmpz_init_set_ui(power, 1); fmpz_init(value);
+    fmpz_mul_2exp(den, den, (ulong) (-e));
+    fmpz_mul_2exp(power, power, 50 * (ulong) (-e) + (wilkinson ? 0 : 1));
+    if (!wilkinson)
+    {
+        fmpz_pow_ui(value, m, 50);
+        fmpz_sub(value, value, power);
+    }
+    else
+    {
+        factors = _fmpz_vec_init(50);
+        for (i = 0; i < 50; i++)
+        {
+            fmpz_mul_ui(value, den, (ulong) i + 1);
+            fmpz_sub(factors + i, m, value);
+        }
+        for (n = 50; n > 1; n = (n + 1) / 2)
+        {
+            for (j = 0; j < n / 2; j++)
+                fmpz_mul(factors + j, factors + 2 * j, factors + 2 * j + 1);
+            if (n % 2)
+                fmpz_set(factors + n / 2, factors + n - 1);
+        }
+        fmpz_add(value, factors, power);
+        _fmpz_vec_clear(factors, 50);
+    }
+    sign = fmpz_sgn(value);
+    fmpz_clear(den); fmpz_clear(power); fmpz_clear(value);
+    return sign;
+}
+
+int main(int argc, char ** argv)
+{
+    int wilkinson = argc > 1 && !strcmp(argv[1], "wilkinson"), st, failures = 0;
+    slong prec = argc > 2 ? atol(argv[2]) : 2097152, n = wilkinson ? 50 : 2, m, i, exponent;
+    arb_ptr balls = _arb_vec_init(n);
+    fmpz_poly_t f, linear;
+    fmpz_t a, b, e, width, midpoint, bound;
+    fmpz_poly_init(f); fmpz_poly_init(linear);
+    fmpz_init(a); fmpz_init(b); fmpz_init(e);
+    fmpz_init(width); fmpz_init(midpoint); fmpz_init(bound);
+    if (wilkinson)
+    {
+        fmpz_poly_one(f);
+        for (i = 1; i <= 50; i++)
+        {
+            fmpz_poly_set_coeff_si(linear, 1, 1); fmpz_poly_set_coeff_si(linear, 0, -i);
+            fmpz_poly_mul(f, f, linear);
+            fmpz_set_si(a, 4 * i - 1); fmpz_set_si(b, 4 * i + 1);
+            failures += sign_value(a, -2, 1) * sign_value(b, -2, 1) >= 0;
+        }
+        fmpz_add_ui(f->coeffs, f->coeffs, 1);
+    }
+    else
+    {
+        fmpz_poly_set_coeff_si(f, 50, 1); fmpz_poly_set_coeff_si(f, 0, -2);
+    }
+    st = adf_roots_real_isolate_counted(balls, &m, f, prec, n);
+    failures += st != ADF_OK || m != n;
+    for (i = 0; st == ADF_OK && i < m; i++)
+    {
+        arb_get_interval_fmpz_2exp(a, b, e, balls + i); exponent = fmpz_get_si(e);
+        failures += fmpz_cmp(a, b) >= 0 || sign_value(a, exponent, wilkinson) *
+                    sign_value(b, exponent, wilkinson) >= 0;
+        fmpz_sub(width, b, a); fmpz_mul_2exp(width, width, (ulong) prec);
+        fmpz_add(midpoint, a, b); fmpz_abs(midpoint, midpoint);
+        failures += fmpz_cmp(width, midpoint) > 0;
+        if (wilkinson)
+        {
+            fmpz_one(bound); fmpz_mul_2exp(bound, bound, (ulong) (-exponent));
+            fmpz_mul_ui(midpoint, bound, (ulong) (4 * (i + 1) - 1));
+            fmpz_mul_2exp(width, a, 2); failures += fmpz_cmp(width, midpoint) < 0;
+            fmpz_mul_ui(midpoint, bound, (ulong) (4 * (i + 1) + 1));
+            fmpz_mul_2exp(width, b, 2); failures += fmpz_cmp(width, midpoint) > 0;
+        }
+        else
+            failures += i == 0 ? fmpz_sgn(b) >= 0 : fmpz_sgn(a) <= 0;
+    }
+    printf("%s prec %ld status %d roots %ld independent-sign failures %d\n",
+           wilkinson ? "wilkinson+1" : "X^50-2", (long) prec, st, (long) m, failures);
+    fmpz_clear(a); fmpz_clear(b); fmpz_clear(e); fmpz_clear(width);
+    fmpz_clear(midpoint); fmpz_clear(bound);
+    _arb_vec_clear(balls, n); fmpz_poly_clear(f); fmpz_poly_clear(linear); flint_cleanup();
+    return failures != 0;
+}
diff --git a/lanes/r-cost1/guard_probe.c b/lanes/r-cost1/guard_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..98679e88114e4b69eccd3c4906066bd321f4c4e0
--- /dev/null
+++ b/lanes/r-cost1/guard_probe.c
@@ -0,0 +1,28 @@
+/* Focused red checks for the sampled overflow and minimum-bound survivors. */
+#include "roots_guard_probe.c"
+#include <stdio.h>
+
+int main(void)
+{
+    fmpz_poly_t h;
+    slong K, product = 123;
+    int failures = 0, ok;
+    fmpz_poly_init(h);
+    fmpz_poly_set_coeff_si(h, 1, 1); fmpz_poly_set_coeff_si(h, 0, -1);
+    ok = root_bound_exp(&K, h);
+    failures += !ok || K != 1;
+    printf("X - 1 bound: returned %d, K %ld, expected 1\n", ok, (long) K);
+    ok = mul_checked_nonneg(&product, WORD_MAX, 2);
+    failures += ok != 0;
+    printf("WORD_MAX times 2: returned %d, expected refusal\n", ok);
+    if (ok == 0)
+    {
+        fmpz_poly_set_coeff_si(h, 1, 0); fmpz_poly_set_coeff_si(h, 2, 1);
+        ok = bound_holds(h, WORD_MAX);
+        failures += ok != -1;
+        printf("degree-two shift overflow: returned %d, expected -1\n", ok);
+    }
+    fmpz_poly_clear(h); flint_cleanup();
+    printf("%d failed checks\n", failures);
+    return failures != 0;
+}
diff --git a/lanes/r-cost1/guard_probes.py b/lanes/r-cost1/guard_probes.py
new file mode 100644
index 0000000000000000000000000000000000000000..dc50fcd5abf9b8ffa7654dbcdf94e21eab4ef217
--- /dev/null
+++ b/lanes/r-cost1/guard_probes.py
@@ -0,0 +1,25 @@
+"""Run two sampled survivors against focused arithmetic checks, within the mutation window."""
+import subprocess
+from pathlib import Path
+
+lane = Path("lanes/r-cost1")
+source = Path("src/roots_real.c").read_text()
+changes = [("bound", "r = fmpz_cmp(lhs, rhs) > 0;", "r = fmpz_cmp(lhs, rhs) > 1;"),
+           ("overflow", "if (x != 0 && y > WORD_MAX / x)\n        return 0;",
+            "if (x != 0 && y > WORD_MAX / x)\n        return 1;"),
+           ("bound_status", "if (!mul_checked_nonneg(&s, a, n))\n        return -1;",
+            "if (!mul_checked_nonneg(&s, a, n))\n        return 0;")]
+for name, old, new in changes:
+    assert source.count(old) == 1
+    (lane / "roots_guard_probe.c").write_text(source.replace(old, new))
+    command = ["timeout", "170", "taskset", "-c", "2,3", "cc", "-std=c11", "-O2", "-Iinclude",
+               str(lane / "guard_probe.c"), "-lflint", "-lgmp", "-lm", "-o",
+               str(lane / "build-mutcache/guard-probe")]
+    result = subprocess.run(command, capture_output=True, text=True)
+    if result.returncode:
+        raise RuntimeError(result.stderr)
+    result = subprocess.run(["timeout", "170", "taskset", "-c", "2,3",
+                             str(lane / "build-mutcache/guard-probe")], capture_output=True, text=True)
+    (lane / f"guard-{name}-red.log").write_text(result.stdout + result.stderr)
+    print(name, "exit", result.returncode, result.stdout.strip(), flush=True)
+    assert result.returncode == 1
diff --git a/lanes/r-cost1/measure.py b/lanes/r-cost1/measure.py
new file mode 100644
index 0000000000000000000000000000000000000000..d2a555e5c3cf037e1332629d7c213c37c296d104
--- /dev/null
+++ b/lanes/r-cost1/measure.py
@@ -0,0 +1,21 @@
+"""One bounded batch of the real-root benchmark, pinned to CPU 2."""
+import json
+import re
+import subprocess
+import sys
+import time
+
+binary, output, mode, family, e, degree, prec, repetitions = sys.argv[1:]
+for repetition in range(int(repetitions)):
+    command = ["timeout", "170", "taskset", "-c", "2", binary, mode, family, e, degree, prec]
+    start = time.time()
+    result = subprocess.run(command, capture_output=True, text=True)
+    row = dict(command=command, repetition=repetition, exit=result.returncode,
+               stdout=result.stdout, stderr=result.stderr, start=start, end=time.time())
+    with open(output, "a") as stream:
+        stream.write(json.dumps(row) + "\n")
+    seconds = re.findall(r"(?:adf|count|eval2): ([0-9.]+)", result.stdout)
+    print(f"{mode} {family} {e} {degree} {prec} run {repetition}: exit {result.returncode}, {seconds}",
+          flush=True)
+    if result.returncode:
+        break
diff --git a/lanes/r-cost1/measurements.md b/lanes/r-cost1/measurements.md
new file mode 100644
index 0000000000000000000000000000000000000000..17f7249af92c80d4148fc0fc362c1e63343e5909
--- /dev/null
+++ b/lanes/r-cost1/measurements.md
@@ -0,0 +1,37 @@
+# Measurements before changes
+
+All benchmark commands use `timeout 170 taskset -c 2`. Times are wall seconds.
+The table is incremental. Completed medians use five serial runs on CPU 2.
+Raw runs are in before.jsonl. The first random run overlapped a profiling run.
+The early sqrt2, xn2 at 16384, and first xn2 at 65536 overlapped the last cluster runs.
+Those rows are excluded from final comparisons and will be repeated serially.
+
+| Input | prec | Before median s | Runs |
+| --- | ---: | ---: | ---: |
+| dense random, degree 50, 10000 bits, seed (1,2) | 2 | 18.647433 | 5 |
+| prod (X - 2^190 - i), i=1..50 | 2 | 0.070947 | 5 |
+| prod (X - i), i=1..50 | 2 | 0.014045 | 5 |
+| prod (X - i 2^150), i=1..50 | 2 | 2.962556 | 5 |
+| prod (2^150 X - i), i=1..50 | 2 | 0.110470 | 5 |
+
+One preliminary scratch profile of X^50 - 2 at 16384 bits (overlapped; no timing comparison):
+34 QIR attempts, 98 exact value evaluations, 76 sign calls, 52 exact sign fallbacks.
+The refinement already doubles the QIR exponent after a success.
+This count suggests measuring filter cancellation before changing the refinement sequence.
+
+Serial scratch profiles (one run each; times are not five-run medians):
+
+| Input | prec | Count s | Isolation/refinement s | Certificate s | Complete verifier s |
+| --- | ---: | ---: | ---: | ---: | ---: |
+| cluster, e=190, d=50 | 2 | 11.885964 | 0.151242 | 0.014082 | 13.916625 |
+| random, bits=10000, d=50 | 2 | 20.135522 | 1.619963 | 0.019296 | 23.194535 |
+| X^50 - 2 | 262144 | 0.000007 | 25.729195 | 13.582454 | 6.749715 |
+
+X^50 - 2 at 262144 used 42 QIR attempts, 130 exact values, and 68 exact sign fallbacks.
+The coefficient translation cost 0.000511 s; it is done once per initial cell.
+The endpoint certificate already exceeds 10 s here. It is unchanged by this lane.
+
+Red regression: `timeout 170 taskset -c 3 lanes/r-cost1/build-red/test_roots_real_isolate`.
+15 tests, 19244 checks, 1 failed check. The new test saw 98 exact evaluations against a bound of 16.
+The exact ball oracle passed. The shell command also printed the log tail, so the shell's final status
+was 0; the test program's own summary records the assertion failure.
diff --git a/lanes/r-cost1/oracle_cases.c b/lanes/r-cost1/oracle_cases.c
new file mode 100644
index 0000000000000000000000000000000000000000..a3755facf25e41c87e23fb87b627779181eb13c0
--- /dev/null
+++ b/lanes/r-cost1/oracle_cases.c
@@ -0,0 +1,32 @@
+/* Run benchmark cases through the test's independent rational Sturm oracle. */
+#define ADF_TEST_NO_MAIN
+#include "../../tests/test_roots_real_isolate.c"
+#define main benchmark_main
+#define now benchmark_now
+#define sign_at benchmark_sign_at
+#define family benchmark_family
+#include "../../bench/bench_roots_real.c"
+#undef sign_at
+#undef family
+#undef now
+#undef main
+
+int main(int argc, char ** argv)
+{
+    fmpz_poly_t f;
+    adf_rootlist_t L;
+    slong prec;
+    int st, truth;
+    if (argc != 5)
+        return 2;
+    prec = atol(argv[4]);
+    fmpz_poly_init(f); adf_rootlist_init(L);
+    if (!benchmark_family(f, argv[1], strtoul(argv[2], NULL, 10), atol(argv[3])))
+        return 2;
+    st = adf_roots_real(L, f, prec);
+    truth = st == ADF_OK && balls_true(L->g, L->ball, L->n, prec, argv[1]);
+    printf("%s prec %ld status %d roots %ld oracle %d checks %lu failures %lu\n",
+           argv[1], (long) prec, st, (long) L->n, truth, adf_test_checks, adf_test_failures);
+    adf_rootlist_clear(L); fmpz_poly_clear(f); flint_cleanup();
+    return !truth || adf_test_failures != 0;
+}
diff --git a/lanes/r-cost1/paired.py b/lanes/r-cost1/paired.py
