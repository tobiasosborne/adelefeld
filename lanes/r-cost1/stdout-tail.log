index 0000000000000000000000000000000000000000..796525664b19ea93b39af45dc64259d68daae805
--- /dev/null
+++ b/lanes/r-cost1/paired.py
@@ -0,0 +1,23 @@
+"""Five interleaved before/after calls on one CPU, bounded individually."""
+import json
+import re
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+family, e, degree, prec = sys.argv[1:5]
+repetitions = int(sys.argv[5]) if len(sys.argv) > 5 else 5
+lane = Path("lanes/r-cost1")
+for repetition in range(repetitions):
+    for phase in ("before", "after"):
+        binary = lane / f"build-{phase}/bench_roots_real"
+        command = ["timeout", "170", "taskset", "-c", "2", str(binary), "adf", family, e, degree, prec]
+        start = time.time()
+        result = subprocess.run(command, capture_output=True, text=True)
+        row = dict(command=command, repetition=repetition, exit=result.returncode,
+                   stdout=result.stdout, stderr=result.stderr, start=start, end=time.time())
+        with (lane / "paired.jsonl").open("a") as stream:
+            stream.write(json.dumps(row) + "\n")
+        times = re.findall(r"adf: ([0-9.]+)", result.stdout)
+        print(phase, family, prec, repetition, "exit", result.returncode, times, flush=True)
diff --git a/lanes/r-cost1/prepare_checks.py b/lanes/r-cost1/prepare_checks.py
new file mode 100644
index 0000000000000000000000000000000000000000..8d77b2e870338774c4bd66b2097c3df605d9399f
--- /dev/null
+++ b/lanes/r-cost1/prepare_checks.py
@@ -0,0 +1,31 @@
+"""Read-only mirrors for driver and mutation tools with fixed build destinations."""
+from pathlib import Path
+
+root = Path.cwd()
+lane = root / "lanes/r-cost1"
+
+driver = lane / "build-driver-root"
+driver.mkdir(exist_ok=True)
+for name in ("Makefile", "include", "src", "tests"):
+    path = driver / name
+    if not path.exists():
+        path.symlink_to(root / name)
+tools = driver / "tools/adf"
+tools.mkdir(parents=True, exist_ok=True)
+for name in ("Makefile", "adf.c"):
+    path = tools / name
+    if not path.exists():
+        path.symlink_to(root / "tools/adf" / name)
+
+# The mutation tool copies lanes recursively. Its scratch must be outside its input
+# root, and only the cache this lane needs is included in the mirror's lanes.
+mutation = lane / "build-mutation-root"
+mutation.mkdir(exist_ok=True)
+for name in ("Makefile", "include", "src", "tests"):
+    path = mutation / name
+    if not path.exists():
+        path.symlink_to(root / name)
+cache = mutation / "lanes/r-cost1/build-mutcache"
+cache.parent.mkdir(parents=True, exist_ok=True)
+if not cache.exists():
+    cache.symlink_to(lane / "build-mutcache")
diff --git a/lanes/r-cost1/profile.py b/lanes/r-cost1/profile.py
new file mode 100644
index 0000000000000000000000000000000000000000..6f08f032a33e8da47e42d0a25851b642d7f30423
--- /dev/null
+++ b/lanes/r-cost1/profile.py
@@ -0,0 +1,103 @@
+"""Make clock-instrumented copies. Originals are never changed."""
+from pathlib import Path
+import sys
+
+lane = Path(sys.argv[1] if len(sys.argv) > 1 else "lanes/r-cost1")
+lane.mkdir(parents=True, exist_ok=True)
+clock = '''
+#include <stdio.h>
+#include <time.h>
+static double cost_now(void)
+{
+    struct timespec t;
+    clock_gettime(CLOCK_MONOTONIC_RAW, &t);
+    return t.tv_sec + 1e-9 * t.tv_nsec;
+}
+'''
+s = Path("src/roots.c").read_text()
+s = "#define _POSIX_C_SOURCE 200809L\n" + clock + s
+s = s.replace("count = real_count(g);", '''double cost_t = cost_now();
+        count = real_count(g);
+        fprintf(stderr, "section count %.6f\\n", cost_now() - cost_t);''')
+s = s.replace("st = adf_roots_real_isolate_counted(cand, &m, g, prec, count);", '''cost_t = cost_now();
+        st = adf_roots_real_isolate_counted(cand, &m, g, prec, count);
+        fprintf(stderr, "section isolate_refine %.6f\\n", cost_now() - cost_t);''')
+# Count and isolation are inside the degree block; finish is outside it.
+needle = "st = real_finish(out, g, count, cand, m, prec);"
+s = s.replace(needle, '''{
+        double cost_t = cost_now();
+        ''' + needle + '''
+        fprintf(stderr, "section certificate %.6f\\n", cost_now() - cost_t);
+    }''')
+lane.joinpath("roots_profile.c").write_text(s)
+s = Path("src/roots_real.c").read_text()
+s = "#define _POSIX_C_SOURCE 200809L\n" + clock + '''
+static double cost_exact, cost_secant, cost_sign, cost_shift, cost_isolate;
+static long cost_values, cost_qir, cost_signs, cost_fallback;
+''' + s
+s = s.replace("slong i, d = fmpz_poly_degree(g), t;",
+              "double cost_t = cost_now();\n    slong i, d = fmpz_poly_degree(g), t;")
+s = s.replace("    fmpz_clear(x);\n}\n\n/* Values", '''    fmpz_clear(x);
+    cost_exact += cost_now() - cost_t; cost_values++;
+}
+
+/* Values''')
+s = s.replace("    arb_t fa, fb, r;", "    double cost_t = cost_now();\n    arb_t fa, fb, r;")
+s = s.replace("    return ok;\n}\n\nstatic int\nsign_2exp", '''    cost_secant += cost_now() - cost_t;
+    return ok;
+}
+
+static int
+sign_2exp''')
+s = s.replace("    fmpz_t r;\n    arb_t ball;", "    double cost_t = cost_now();\n    fmpz_t r;\n    arb_t ball;")
+s = s.replace("        if (s != 0)\n            return s;", '''        if (s != 0)
+        {
+            cost_sign += cost_now() - cost_t; cost_signs++;
+            return s;
+        }''')
+s = s.replace("    fmpz_clear(r);\n    return s;", '''    fmpz_clear(r);
+    cost_sign += cost_now() - cost_t; cost_signs++; cost_fallback++;
+    return s;''')
+s = s.replace("                if (s != 0)\n                    return s;", '''                if (s != 0)
+                {
+                    cost_sign += cost_now() - cost_t; cost_signs++;
+                    return s;
+                }''')
+s = s.replace("    slong e = *k - jj;", "    slong e = *k - jj;\n    cost_qir++;")
+s = s.replace("    st = refine_local(c, k, point, &f, &df, floor, has_floor, need);", '''    cost_shift += cost_now() - cost_t;
+    st = refine_local(c, k, point, &f, &df, floor, has_floor, need);''')
+s = s.replace("    local_eval f, df;", "    double cost_t = cost_now();\n    local_eval f, df;")
+s = s.replace("    *m = 0;\n    if (d < 1", '''    double cost_t = cost_now();
+    cost_exact = cost_secant = cost_sign = cost_shift = 0;
+    cost_values = cost_qir = cost_signs = cost_fallback = 0;
+    *m = 0;
+    if (d < 1''')
+s = s.replace("        items_sort(&it);", "        cost_isolate = cost_now() - cost_t;\n        items_sort(&it);")
+s = s.replace("    items_clear(&it);\n    arf_clear(floor);", '''    fprintf(stderr, "detail tree %.6f shift %.6f secant %.6f sign %.6f exact %.6f "
+            "values %ld qir %ld signs %ld fallback %ld\\n", cost_isolate, cost_shift, cost_secant,
+            cost_sign, cost_exact, cost_values, cost_qir, cost_signs, cost_fallback);
+    items_clear(&it);
+    arf_clear(floor);''')
+lane.joinpath("refine_profile.c").write_text(s)
+s = Path("bench/bench_roots_real.c").read_text()
+s = s.replace("    adf_rootlist_clear(L);\n    return t1 - t0;", '''    double v0 = now();
+    int verified = adf_rootlist_verify_complete(L, g, 0);
+    fprintf(stderr, "section verifier %.6f result %d\\n", now() - v0, verified);
+    adf_rootlist_clear(L);
+    return t1 - t0;''')
+lane.joinpath("bench_profile.c").write_text(s)
+s = Path("refs/src/flint-src-3.0.1/fmpz_poly/num_real_roots_sturm.c").read_text()
+s = "#define _POSIX_C_SOURCE 200809L\n" + clock + s
+s = s.replace("    fmpz_t a, b, g, h;", '''    double total_t = cost_now(), rem_time = 0, div_time = 0, t;
+    long remainders = 0;
+    fmpz_t a, b, g, h;''')
+s = s.replace("        _fmpz_poly_pseudo_rem_cohen(A, A, lenA, B, lenB);", '''        t = cost_now();
+        _fmpz_poly_pseudo_rem_cohen(A, A, lenA, B, lenB);
+        rem_time += cost_now() - t; remainders++;''')
+s = s.replace("            _fmpz_vec_scalar_divexact_fmpz(B, B, lenB, b);", '''            t = cost_now();
+            _fmpz_vec_scalar_divexact_fmpz(B, B, lenB, b);
+            div_time += cost_now() - t;''')
+s = s.replace("    _fmpz_vec_clear(W, 2*len - 1);", '''    _fmpz_vec_clear(W, 2*len - 1);
+    fprintf(stderr, "sturm total %.6f remainder %.6f division %.6f steps %ld\\n",
+            cost_now() - total_t, rem_time, div_time, remainders);''')
+lane.joinpath("sturm_profile.c").write_text(s)
diff --git a/lanes/r-cost1/stack_probe.c b/lanes/r-cost1/stack_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..222c56b6872237156973996e3d6ddd7309179e49
--- /dev/null
+++ b/lanes/r-cost1/stack_probe.c
@@ -0,0 +1,23 @@
+#include "roots_stack_probe.c"
+#include <stdio.h>
+
+int main(void)
+{
+    static const slong numerators[] = { 32, 36, 80, 84, 104, 108, 116, 118, 122, 123, 125, 126 };
+    fmpz_poly_t f, linear;
+    arb_ptr b = _arb_vec_init(12);
+    slong i, m;
+    int st;
+    fmpz_poly_init(f); fmpz_poly_init(linear); fmpz_poly_one(f);
+    for (i = 0; i < 12; i++)
+    {
+        fmpz_poly_set_coeff_si(linear, 1, 2);
+        fmpz_poly_set_coeff_si(linear, 0, -numerators[i]);
+        fmpz_poly_mul(f, f, linear);
+    }
+    fmpz_poly_primitive_part(f, f);
+    st = adf_roots_real_isolate_counted(b, &m, f, 2, 12);
+    printf("stack fixture status %d roots %ld\n", st, (long) m);
+    _arb_vec_clear(b, 12); fmpz_poly_clear(f); fmpz_poly_clear(linear); flint_cleanup();
+    return st != ADF_OK || m != 12;
+}
diff --git a/lanes/r-cost1/tables.py b/lanes/r-cost1/tables.py
new file mode 100644
index 0000000000000000000000000000000000000000..43b581d77ccc73aa724df79896f2f45f323abb39
--- /dev/null
+++ b/lanes/r-cost1/tables.py
@@ -0,0 +1,54 @@
+"""Summarise raw bounded benchmark runs; keep exclusions explicit."""
+import collections
+import json
+import re
+import statistics
+from pathlib import Path
+
+lane = Path("lanes/r-cost1")
+groups = collections.defaultdict(list)
+for name in ("before.jsonl", "before-serial.jsonl", "counts.jsonl", "after.jsonl", "paired.jsonl",
+             "references.jsonl"):
+    path = lane / name
+    if not path.exists():
+        continue
+    for index, line in enumerate(path.read_text().splitlines()):
+        row = json.loads(line)
+        command = row["command"]
+        binary, mode, family, e, degree, prec = command[-6:]
+        if name == "before.jsonl":
+            if family == "random" and index == 0:
+                continue
+            if family in ("cluster", "sqrt2", "xn2") and prec != "262144":
+                continue
+            if family == "xn2" and prec == "262144":
+                # These three serial runs were before the repeat batch.
+                pass
+        phase = "after" if "build-after" in binary else "before"
+        if name == "paired.jsonl":
+            phase = "paired " + phase
+        if name == "counts.jsonl":
+            phase = "count experiment"
+        if name == "references.jsonl":
+            phase = "reference"
+        match = re.search(r"(?:adf|count|eval2): ([0-9.]+)", row["stdout"])
+        seconds = float(match.group(1)) if match else None
+        groups[(phase, mode, family, e, degree, prec)].append((seconds, row["exit"]))
+
+lines = ["| Phase | Mode/input | e | d | prec | Completed/attempts | Median s | Range s |",
+         "| --- | --- | ---: | ---: | ---: | ---: | ---: | --- |"]
+for key, rows in groups.items():
+    phase, mode, family, e, degree, prec = key
+    times = [t for t, exit_code in rows if t is not None and exit_code == 0]
+    if phase.startswith("paired") or phase == "reference":
+        times = times[-5:]
+    if times:
+        median = f"{statistics.median(times):.9f}"
+        span = f"{min(times):.6f} to {max(times):.6f}"
+    else:
+        median = ">170 (censored)" if all(code == 124 for _, code in rows) else "unavailable"
+        span = "-"
+    lines.append(f"| {phase} | {mode}/{family} | {e} | {degree} | {prec} | "
+                 f"{len(times)}/{len(rows)} | {median} | {span} |")
+lane.joinpath("tables.md").write_text("\n".join(lines) + "\n")
+print("\n".join(lines))
