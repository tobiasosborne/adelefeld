from pathlib import Path
lane = Path('lanes/r-cost1')
large = []
long = []
no_newline = []
for p in lane.rglob('*'):
    if p.is_file():
        data = p.read_bytes()
        if len(data) > 100000:
            large.append((str(p), len(data)))
        if data and not data.endswith(b'\\n'):
            no_newline.append(str(p))
        if p.suffix in ('.md', '.py', '.c', '.patch'):
            long += [(str(p), i + 1, len(s)) for i, s in enumerate(data.decode().splitlines()) if len(s) > 116]
print('large', large)
print('no newline', no_newline)
print('long', long[:30], 'total', len(long))
print('build trees', list(lane.glob('build*')))
print('report bytes', (lane / 'report.md').stat().st_size)
PY
