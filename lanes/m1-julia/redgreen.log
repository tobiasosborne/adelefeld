DEMO 2: adf_rat_struct, one 8-byte field added (size 16 -> 24; alignment unchanged, 8).
================================================================================

--- mutation: build/redgreen/mut2/include/adelefeld/rat.h ---

--- include/adelefeld/rat.h
+++ build/redgreen/mut2/include/adelefeld/rat.h
@@ -31,6 +31,7 @@
 typedef struct
 {
     fmpq_t q;
+    long pad; /* MUTATION (lane m1-julia, red-green demo): grows the struct from 16 to 24 bytes */
 } adf_rat_struct;

 typedef adf_rat_struct adf_rat_t[1];

--- build ---

    cc -shared -fPIC -Ibuild/redgreen/mut2/include -std=c11 -O1 -g -Wall -Wextra \
        build/redgreen/mut2/src/*.c -o build/redgreen/mut2/libadelefeld.so -lflint -lgmp -lm

Clean build, no warnings, no errors.

